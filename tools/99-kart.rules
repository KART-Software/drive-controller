# KART drive-controller の USB デバイス (Linux の udev ルール)。/etc/udev/rules.d/ にコピーして `sudo udevadm control --reload`。
#   sudo cp tools/99-kart.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# - 一般ユーザーがシリアルを開けるようにする (dialout グループに入っていなくてもよい)
# - ModemManager がモデムと思って AT コマンドを流し込まないようにする
# Teensy (dc-main、ブートローダ) は PJRC の 00-teensy.rules (~/.platformio/packages/tool-teensy/) と同じ内容
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04*", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0666"
# dc-sd-reader (TinyUSB の CDC + Mass Storage。pid.codes のテスト用 VID/PID)
ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0666"
